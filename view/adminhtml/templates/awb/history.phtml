<?php
/** @var $block History */
/** @var \Magento\Framework\Escaper $escaper */
use SamedayCourier\Shipping\Block\Adminhtml\Awb\History;
?>

<section class="admin__page-section">
    <div class="admin__page-section-content">
        <div class="admin__page-section-item">
            <section class="admin__page-section sameday-courier-section">
                <div id="popup-awb-history" style="display: block" class="samedaycourier_shipping_awb_history">
                    <?php
                    $packageRows = '';
                    foreach ($block->getParcelsHistory() as $package) {
                        $summary = $package->getSummary();
                        $packageHistory = $package->getHistory();
                        $historyRows = '';
                        foreach ($packageHistory as $history) {
                            $historyRows .=
                                '<td>' . $escaper->escapeHtml($history->getName()) . '</td>' .
                                '<td>' . $escaper->escapeHtml($history->getLabel()) . '</td>' .
                                '<td>' . $escaper->escapeHtml($history->getState()) . '</td>' .
                                '<td>' . $escaper->escapeHtml($history->getDate()->format('Y-m-d H:i:s')) . '</td>' .
                                '<td>' . $escaper->escapeHtml($history->getCounty()) . '</td>' .
                                '<td>' . $escaper->escapeHtml($history->getTransitLocation()) . '</td>' .
                                '<td>' . $escaper->escapeHtml($history->getReason()) . '</td>'
                            ;
                        }
                        $awbNumber = $summary->getParcelAwbNumber();
                        $pickedUpAt = $summary->getPickedUpAt()
                            ? $summary->getPickedUpAt()->format('Y-m-d H:i:s')
                            : '';
                        $packageRows .=
                            '<tr>' .
                            '<td style="text-align: center; cursor:pointer;" class="showHistoryDetails" value="-" data-awb-number="' .
                            $escaper->escapeHtmlAttr($awbNumber) .
                            '"> <strong> + </strong> </td>' .
                            '<td>' . $escaper->escapeHtml($awbNumber) . '</td>' .
                            '<td>' . $escaper->escapeHtml((string) $summary->getParcelWeight()) . '</td>' .
                            '<td>' . $escaper->escapeHtml($summary->isDelivered() ? 'Yes' : 'No') . '</td>' .
                            '<td>' . $escaper->escapeHtml((string) $summary->getDeliveryAttempts()) . ' </td>' .
                            '<td>' . $escaper->escapeHtml($summary->isPickedUp() ? 'Yes' : 'No') . '</td>' .
                            '<td>' . $escaper->escapeHtml($pickedUpAt) . '</td>' .
                            '</tr>' .
                            '<tr>' .
                            '<td colspan="7">' .
                            '<table class="history" id="history-' .
                            $escaper->escapeHtmlAttr($awbNumber) .
                            '" style="width: 100%; display: none; text-align: center">' .
                            '<tr>' .
                            '<th style="width: 15%">' . $escaper->escapeHtml(__('Status')) . '</th>' .
                            '<th style="width: 15%">' . $escaper->escapeHtml(__('Label')) . '</th>' .
                            '<th style="width: 15%">' . $escaper->escapeHtml(__('State')) . '</th>' .
                            '<th style="width: 15%">' . $escaper->escapeHtml(__('Date')) . '</th>' .
                            '<th style="width: 15%">' . $escaper->escapeHtml(__('County')) . '</th>' .
                            '<th style="width: 15%">' . $escaper->escapeHtml(__('Translation')) . '</th>' .
                            '<th style="width: 15%">' . $escaper->escapeHtml(__('Reason')) . '</th>' .
                            '</tr>' .
                            $historyRows .
                            '</table>' .
                            '</td>' .
                            '</tr>'
                        ;
                    }
                    ?>
                    <table class="packages" style="width: 100%">
                        <tr>
                            <th></th>
                            <th scope="col"><?= $escaper->escapeHtml(__('Parcel number')) ?></th>
                            <th scope="col"><?= $escaper->escapeHtml(__('Parcel weight')) ?></th>
                            <th scope="col"><?= $escaper->escapeHtml(__('Delivered')) ?></th>
                            <th scope="col"><?= $escaper->escapeHtml(__('Delivery attempts')) ?></th>
                            <th scope="col"><?= $escaper->escapeHtml(__('Is picked up')) ?></th>
                            <th scope="col"><?= $escaper->escapeHtml(__('Picked up at')) ?></th>
                        </tr>
                        <?= /* @noEscape */ $packageRows ?>
                    </table>
                </div>
            </section>
        </div>
    </div>
</section>
